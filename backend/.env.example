# Copy this file to .env and adjust for your machine. Never commit .env itself.

# --- App ---
APP_NAME=AtmoGuard API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- CORS --- comma-separated list of origins the frontend is served from
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Local Postgres example (matches `createdb atmoguard` with no password / peer auth):
DATABASE_URL=postgresql+psycopg2://localhost:5432/atmoguard

# --- Logging ---
LOG_LEVEL=INFO

# --- Weather providers ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=10.0
HTTP_RETRY_ATTEMPTS=2
HTTP_RETRY_BACKOFF_SECONDS=0.8
WEATHER_CACHE_TTL_SECONDS=300

# IMD's API (api.imd.gov.in) is documented but requires an approved key —
# leave unset until one is obtained. See app/services/providers/imd.py.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=

# --- Automated alert pipeline (Phase 5) --- see app/services/pipeline.py
PIPELINE_ENABLED=true
PIPELINE_INTERVAL_SECONDS=900

# --- ML model warmup (Phase 2 Step 5) --- see app/ml/model_registry.py
MODEL_WARMUP_ENABLED=true
