# Copy to .env.local (Vite auto-loads it) if you want to override these.
# The app works with zero configuration — both defaults below match the
# backend's own defaults out of the box.

# Base URL of the FastAPI backend (see backend/.env.example's API_V1_PREFIX).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to "false" to skip the backend entirely and always use the direct
# Open-Meteo path (src/services/weatherService.js) — e.g. while the backend
# is known to be down. Any other value (or unset) tries the backend first.
VITE_USE_BACKEND=true
